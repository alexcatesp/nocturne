# KStars/Ekos, headless, on its own session bus.
#
# The Ekos DBus bridge attaches to org.kde.kstars on the session bus this unit
# creates. Nocturne must run with the same DBUS_SESSION_BUS_ADDRESS.

[Unit]
Description=KStars/Ekos headless for Nocturne
Documentation=https://github.com/alexcatesp/nocturne
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nocturne
Group=nocturne

# No display on the Pi. Qt's offscreen platform plugin keeps KStars headless
# without an X server or Wayland compositor.
Environment=QT_QPA_PLATFORM=offscreen
Environment=HOME=/home/nocturne

# dbus-run-session gives KStars a session bus of its own, so that the bridge has
# something to attach to whether or not anyone is logged in.
#
# `kstars` unqualified, resolved by dbus-run-session through PATH, and not an
# absolute path. This line read /usr/local/bin/kstars, which is where nothing
# installs it: the installer builds with CMAKE_INSTALL_PREFIX=/usr so that one
# libindi exists on the machine rather than two (see install.sh, INSTALL_PREFIX),
# and the reference rig's build went to /usr/bin. The unit would have failed to
# start, at night, with status=203/EXEC.
ExecStart=/usr/bin/dbus-run-session -- kstars

Restart=on-failure
RestartSec=10

# KStars is not trusted with more of the system than it needs.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/nocturne

[Install]
WantedBy=multi-user.target
