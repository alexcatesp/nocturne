# Per-rig safety overrides — copy to `safety.local.yaml` and edit.
#
#     cp config/safety.local.yaml.example config/safety.local.yaml
#
# `safety.local.yaml` is gitignored, and it is the file your measured meridian
# limits belong in: they are a property of your tripod, your tube and your
# camera, and they are wrong for anyone else's rig.
#
# READ THIS BEFORE PUTTING ANYTHING HERE.
#
# These values decide whether ~10 kg of glass swings into a tripod leg at three
# in the morning with nobody watching. A value here silently overrides the
# shipped one. `nocturne check-config` prints every override with the value it
# displaced — read that output after every change, and read it again before the
# first unattended night.
#
# Nocturne never writes this file. Not the agent, not the API, not the
# orchestrator. That is enforced in code and by an unconditional test, and it
# does not change.
#
# What did change: the calibration tool measures your meridian limits and
# writes them to a store of its own, so you no longer have to type them here
# (ADR 0021). This file keeps the last word over that store — see
# absolute_hour_angle_bound_deg below — and typing the limits here by hand
# still works and still wins whenever it is stricter.

# limits:
#   meridian:
#     # false until YOU have measured it. Supervised and autonomous modes are
#     # refused while it is false — a hard failure with an explicit message,
#     # never a warning and never a permissive default (SPEC section 9.1).
#     calibrated: false
#     calibration_date: "2026-01-01"
#     # Hour angle, in degrees, at which the tube must stop on each side.
#     # Measured on your own rig: docs/meridian-calibration.md. West is
#     # positive, east negative. Both are required once calibrated is true.
#     hour_angle_west_limit_deg: 0.0
#     hour_angle_east_limit_deg: 0.0
#     # Subtracted from both limits before they are enforced.
#     safety_margin_deg: 5
#     # The outer envelope. No measured profile — from the calibration tool or
#     # anywhere else — may authorise pointing beyond this hour angle, either
#     # side. It is not a measurement of your tripod: it is what catches a
#     # limit marked three hours off before it becomes an enforced number.
#     absolute_hour_angle_bound_deg: 45
#     # How far the mount may travel before a calibration stops applying. The
#     # polar axis is tilted to your latitude, so the arc the tube sweeps past
#     # the legs changes with it: what you measured on the terrace is not valid
#     # at a dark site 300 km south. 0.5 deg is about 55 km.
#     latitude_tolerance_deg: 0.5
